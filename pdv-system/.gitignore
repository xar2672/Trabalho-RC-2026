gitignore_content = """# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Ignore these files anywhere in the project
**/Credentials.json
**/tokens.json
fonts/

# Databases (Offline PDV Data)
*.sqlite
*.sqlite3
*.db
*.db3

# Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Dependencies (Node.js)
node_modules/
.npm/

# Build / Production Output (Vue.js / Node)
dist/
dist-ssr/
build/
.output/

# Tests / Coverage
coverage/
.nyc_output/

# Docker overrides (Optional)
docker-compose.override.yml

# OS and Editor configurations
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
"""

file_path = ".gitignore"
with open(file_path, "w", encoding="utf-8") as f:
    f.write(gitignore_content)

print(f"Created {file_path}")
